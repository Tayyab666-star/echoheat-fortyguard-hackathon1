# ── EchoHeat Backend Environment ─────────────────────────────
# Copy this file to .env and fill in the values

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://echoheat:echoheat_dev@localhost:27017/echoheat?authSource=admin

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-characters-long-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters-long-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── FortyGuard API ──────────────────────────────────────────
FORTYGUARD_API_KEY=your-fortyguard-api-key
FORTYGUARD_API_URL=https://api.fortyguard.com/v1
FORTYGUARD_MOCK=false
FORTYGUARD_BASE_TEMP=38
FORTYGUARD_HEAT_SPIKE=6

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_AUTHENTICATED=1000
RATE_LIMIT_THERMAL_ENGINE=100
RATE_LIMIT_LOGIN=5

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── SMTP / Email (leave blank to use mock) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Samsara (optional) ──────────────────────────────────────
SAMSARA_API_KEY=
SAMSARA_WEBHOOK_SECRET=
SAMSARA_CLIENT_ID=
SAMSARA_CLIENT_SECRET=
SAMSARA_AUTH_URL=https://cloud.samsara.com/connect

# ── Procore (optional) ──────────────────────────────────────
PROCORE_API_KEY=
PROCORE_WEBHOOK_SECRET=
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_AUTH_URL=https://login.procore.com
PROCORE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/procore/auth-callback

# ── BACnet (optional) ──────────────────────────────────────
BACNET_GATEWAY_URL=

# ── Cache TTLs (seconds) ───────────────────────────────────
CACHE_TTL_FORTYGUARD=300
CACHE_TTL_KPI=120
CACHE_TTL_ASSET_STATUS=30
CACHE_TTL_ALERT_STATS=60
CACHE_TTL_ANALYTICS_ROI=600
CACHE_WARM_ON_START=true
