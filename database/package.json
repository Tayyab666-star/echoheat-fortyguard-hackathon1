{
  "name": "@echoheat/database",
  "version": "1.0.0",
  "private": true,
  "description": "EchoHeat Mongoose schemas, models, and database utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "seed": "tsx src/seeds/seed.ts",
    "db:indexes": "tsx src/createIndexes.ts",
    "migrate:up": "tsx src/migrate.ts up",
    "migrate:status": "tsx src/migrate.ts status"
  },
  "dependencies": {
    "mongoose": "^8.8.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
